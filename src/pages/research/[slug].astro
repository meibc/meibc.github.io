---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const workDetails = await getCollection('research');

  return workDetails.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

interface Props {
  work: CollectionEntry<'research'>;
}

const { work } = Astro.props as Props;
const { Content } = await render(work);
---

<BaseLayout title={`${work.data.title} | Research | Meibin Chen`} description={work.data.summary}>
  <main class="research-detail">
    <div class="layout">
      <aside class="section-nav" aria-label="On this page">
        <div class="section-meta">
          <p class="section-meta-area">{work.data.area}</p>
          <h2 class="section-meta-title">{work.data.title}</h2>
          <p class="section-meta-summary">{work.data.summary}</p>
        </div>
        <p class="section-nav-label">On This Page</p>
        <nav class="section-nav-list" id="section-nav-list"></nav>
        <a class="back-link side-back-link" href="/#research">← Back to Research</a>
      </aside>

      <div class="container">
        <article class="detail-content" id="detail-content">
          <Content />
        </article>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const navRoot = document.getElementById('section-nav-list');
  const contentRoot = document.getElementById('detail-content');

  if (navRoot && contentRoot) {
    const headings = Array.from(contentRoot.querySelectorAll('h2, h3'));
    const slugify = (text) =>
      text
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-');

    headings.forEach((heading) => {
      if (!heading.id) heading.id = slugify(heading.textContent || '');
      const item = document.createElement('a');
      item.href = `#${heading.id}`;
      item.textContent = heading.textContent || '';
      item.className = `section-link section-link-${heading.tagName.toLowerCase()}`;
      navRoot.appendChild(item);
    });

    const links = Array.from(navRoot.querySelectorAll('a'));
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        links.forEach((link) => link.classList.remove('active'));
        const active = navRoot.querySelector(`a[href="#${visible.target.id}"]`);
        active?.classList.add('active');
      },
      {
        rootMargin: '-20% 0px -60% 0px',
        threshold: [0.15, 0.45, 0.75],
      }
    );

    headings.forEach((heading) => observer.observe(heading));

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const href = link.getAttribute('href');
        const target = href ? document.querySelector(href) : null;
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }
</script>

<style>
  .research-detail {
    min-height: 100vh;
    background: var(--color-bg);
    padding: 0;
  }

  .layout {
    width: 100%;
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    gap: 0;
    align-items: start;
  }

  .section-nav {
    position: sticky;
    top: 0;
    min-height: 100vh;
    background: var(--sidebar-bg);
    padding: 35px 20px 26px 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-meta {
    margin-bottom: 24px;
    padding-right: 0;
    text-align: center;
    max-width: 220px;
    width: 100%;
  }

  .section-meta-area {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(61, 61, 61, 0.72);
    margin-bottom: 8px;
    text-align: center;
  }

  .section-meta-title {
    font-size: 1.2rem;
    line-height: 1.2;
    color: rgba(61, 61, 61, 0.95);
    margin: 0 0 10px;
    text-align: center;
  }

  .section-meta-summary {
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgba(61, 61, 61, 0.82);
    margin: 0;
    text-align: center;
  }

  .section-nav-label {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(61, 61, 61, 0.92);
    margin-bottom: 14px;
    text-align: center;
    width: 100%;
    max-width: 210px;
  }

  .section-nav-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
    width: 100%;
    max-width: 210px;
  }

  .section-link {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    line-height: 1.45;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(61, 61, 61, 0.9);
    text-decoration: none;
    padding: 6px 0;
    justify-content: center;
    text-align: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .section-link::before {
    content: '';
    width: 0;
    height: 1px;
    background: rgba(95, 127, 161, 0.9);
    transition: width 0.2s ease;
    flex: 0 0 auto;
  }

  .section-link:hover {
    color: var(--color-accent-light);
    transform: translateX(4px);
  }

  .section-link:hover::before {
    width: 10px;
  }

  .section-link.active {
    color: var(--color-accent-light);
  }

  .section-link.active::before {
    width: 16px;
  }

  .section-link-h3 {
    font-size: 0.76rem;
    font-weight: 600;
    color: rgba(61, 61, 61, 0.75);
    letter-spacing: 0.045em;
    margin-top: -2px;
    margin-bottom: 4px;
    padding-left: 0;
    text-transform: none;
  }

  .container {
    max-width: 680px;
    margin: 0;
    padding: 56px 32px 40px 82px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    margin-bottom: 20px;
    color: var(--text-mid);
  }

  .side-back-link {
    margin-top: 0;
    margin-bottom: 28px;
    text-align: left;
    width: 100%;
    max-width: 210px;
    order: -1;
  }

  .detail-content :global(h2) {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--slate);
    margin: 28px 0 12px;
  }

  .detail-content :global(h3) {
    font-size: 1rem;
    color: var(--text);
    margin: 24px 0 12px;
  }

  .detail-content :global(ul) {
    padding-left: 20px;
    color: var(--text-mid);
    margin: 10px 0 14px;
  }

  .detail-content :global(li) {
    margin-bottom: 8px;
  }

  .detail-content :global(p) {
    color: var(--text-mid);
    line-height: 1.72;
    margin: 0 0 18px;
    max-width: 68ch;
  }

  .detail-content :global(a) {
    font-weight: 700;
    color: var(--color-accent);
    text-underline-offset: 2px;
  }

  .detail-content :global(a:hover) {
    color: var(--color-accent-light);
  }

  .detail-content :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 12px 0 16px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    box-shadow: var(--shadow-sm);
  }

  .detail-content :global(figure) {
    margin: 30px 0 34px;
    width: min(760px, calc(100% + 40px));
    max-width: none;
    margin-left: -20px;
    margin-right: -20px;
  }

  .detail-content :global(figure > a) {
    display: block;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .detail-content :global(figure img) {
    margin: 0;
    border: 0;
    border-radius: 4px;
    box-shadow: none;
  }

  .detail-content :global(figcaption) {
    margin-top: 9px;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-soft);
    font-style: italic;
    text-align: left;
  }

  .detail-content :global(figcaption strong) {
    color: var(--color-accent);
    font-weight: 700;
    font-style: normal;
  }

  .detail-content :global(.research-image-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 12px 0 16px;
  }

  .detail-content :global(.research-image-grid img) {
    margin: 0;
  }

  .detail-content :global(.cta-links) {
    margin-top: 16px;
  }

  .detail-content :global(.cta-links p) {
    margin: 0 0 12px;
  }

  .detail-content :global(.cta-links p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .research-detail {
      padding: var(--space-lg) var(--space-md);
    }

    .layout {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .section-nav {
      display: none;
    }

    .container {
      padding: 0;
    }

    .detail-content :global(.research-image-grid) {
      grid-template-columns: 1fr;
    }

    .detail-content :global(figure) {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

  }
</style>
