---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const workDetails = await getCollection('research');

  return workDetails.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
---

<BaseLayout title={`${work.data.title} | Research | Meibin Chen`} description={work.data.summary}>
  <main class="research-detail">
    <div class="container">
      <a class="back-link" href="/#research">← Back to Research</a>

      <header class="detail-header">
        <p class="eyebrow">{work.data.area}</p>
        <h1>{work.data.title}</h1>
        <p class="summary">{work.data.summary}</p>
      </header>

      <article class="detail-content">
        <Content />
      </article>
    </div>
  </main>
</BaseLayout>

<style>
  .research-detail {
    min-height: 100vh;
    background: var(--color-bg);
    padding: var(--space-xl) var(--space-lg);
  }

  .container {
    max-width: 780px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    margin-bottom: 20px;
    color: var(--text-mid);
  }

  .detail-header {
    margin-bottom: 22px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }

  h1 {
    font-size: 1.8rem;
    line-height: 1.3;
    color: var(--text);
    margin-bottom: 12px;
  }

  .summary {
    color: var(--text-mid);
    line-height: 1.8;
    font-size: 1rem;
  }

  .detail-content :global(h2) {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--slate);
    margin: 22px 0 8px;
  }

  .detail-content :global(ul) {
    padding-left: 20px;
    color: var(--text-mid);
  }

  .detail-content :global(li) {
    margin-bottom: 6px;
  }

  .detail-content :global(p) {
    color: var(--text-mid);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .research-detail {
      padding: var(--space-lg) var(--space-md);
    }

    h1 {
      font-size: 1.45rem;
    }
  }
</style>
