---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="section-header">{label}</div>

<style>
  .section-header {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--slate);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 12px;
    margin-bottom: 0;
  }
</style>
