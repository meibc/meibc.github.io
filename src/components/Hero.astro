---
import profile from '../data/profile.json';

const emphasizeBio = (text: string) =>
  text
    .replace('quantitative and systems-based approaches', '<strong>quantitative and systems-based approaches</strong>')
    .replace('simulation modeling', '<span class="hover-term" tabindex="0"><strong>simulation modeling</strong></span>')
    .replace('decision-relevant tools', '<strong>decision-relevant tools</strong>');

const bioParagraphs = Array.isArray(profile.bio)
  ? profile.bio
  : String(profile.bio)
      .split(/\n+/)
      .map((p) => p.trim())
      .filter(Boolean);

const linkByPlatform = Object.fromEntries(
  (profile.socialLinks ?? []).map((link) => [link.platform, link.url])
);

const linkifyBio = (text: string) =>
  text
    .replace(
      /Research\s+(?:and|or)\s+Publications/i,
      `<a href="#research">Research</a> and <a href="#publications">Publications</a>`
    )
    .replace(
      /GitHub|Github/i,
      `<a href="${linkByPlatform.github || 'https://github.com/meibc'}" target="_blank" rel="noopener noreferrer">GitHub</a>`
    )
    .replace(
      /LinkedIn/i,
      `<a href="${linkByPlatform.linkedin || 'https://linkedin.com/in/'}" target="_blank" rel="noopener noreferrer">LinkedIn</a>`
    )
    .replace(
      /Google Scholar/i,
      `<a href="${linkByPlatform.googleScholar || '#'}" target="_blank" rel="noopener noreferrer">Google Scholar</a>`
    );
---

<section id="about" class="section hero">
  <div class="container hero-grid hero-copy">
    <div class="hero-content">
      <h1 class="hero-name">{profile.name}</h1>
      {bioParagraphs.map((paragraph) => (
        <p class="hero-bio" set:html={linkifyBio(emphasizeBio(paragraph))}></p>
      ))}
    </div>
    <aside class="detail-panel" aria-live="polite">
      <h3>Simulation Modeling</h3>
      <p>I use simulation models to represent feedback loops, delays, adaptation, and behavior over time in complex health and social systems.</p>
      <p>This enables in-silico policy testing before implementation, including intervention timing, scale, and interaction effects under real-world constraints.</p>
      <p>Typical outputs include scenario comparisons, tipping-point sensitivity, and uncertainty-aware projections that support practical decision-making.</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: 78px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0;
    gap: 0;
    align-items: start;
    transition: grid-template-columns 0.22s ease, gap 0.22s ease;
    width: 100%;
  }

  .hero-copy {
    max-width: none !important;
    width: 100%;
    padding-left: 50px;
  }

  .hero-bio {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.56;
    max-width: min(45vw, 684px);
    margin: 0;
  }

  .hero-content {
    display: block;
  }

  .hero-name {
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .hero-bio + .hero-bio {
    margin-top: 1.25rem;
  }

  .hero-bio :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .hero-bio :global(.hover-term) {
    position: relative;
    display: inline;
    cursor: help;
    border-bottom: 1px solid rgba(63, 59, 54, 0.45);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-bio :global(.hover-term:hover),
  .hero-bio :global(.hover-term:focus),
  .hero-bio :global(.hover-term:focus-within) {
    color: #3f3b36;
    border-bottom-color: rgba(63, 59, 54, 0.78);
  }

  .hero-bio :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(95, 127, 161, 0.45);
    transition: color 0.16s ease, text-decoration-color 0.16s ease;
  }

  .hero-bio :global(a:hover) {
    color: var(--color-accent-light);
    text-decoration-color: rgba(71, 105, 140, 0.65);
  }

  .detail-panel {
    min-height: clamp(460px, 68vh, 720px);
    max-height: 78vh;
    width: clamp(360px, 33vw, 560px);
    overflow-y: auto;
    padding: 24px 26px;
    border-radius: 6px;
    border: 1px solid rgba(67, 64, 60, 0.08);
    background: #d4d4d6;
    color: #4c4844;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    font-size: 0.98rem;
    line-height: 1.58;
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    overflow: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .detail-panel h3 {
    font-size: clamp(2.05rem, 3vw, 2.55rem);
    line-height: 1.08;
    font-weight: 700;
    color: #5a5653;
    margin-bottom: 14px;
    text-transform: lowercase;
  }

  .detail-panel p:first-of-type {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 12px;
  }

  .detail-panel p + p {
    margin-top: 11px;
  }

  .detail-panel::-webkit-scrollbar {
    width: 8px;
  }

  .detail-panel::-webkit-scrollbar-thumb {
    background: rgba(84, 80, 75, 0.28);
    border-radius: 999px;
  }

  .hero-copy:has(.hover-term:hover) .detail-panel,
  .hero-copy:has(.hover-term:focus) .detail-panel,
  .hero-copy:has(.hover-term:focus-within) .detail-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    overflow-y: auto;
  }

  .hero-copy:has(.hover-term:hover),
  .hero-copy:has(.hover-term:focus),
  .hero-copy:has(.hover-term:focus-within) {
    grid-template-columns: minmax(0, 1fr) clamp(360px, 33vw, 560px);
    gap: 32px;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 0.25rem;
    }

    .hero-bio {
      font-size: 0.94rem;
      line-height: 1.62;
      max-width: 100%;
    }

    .hero-name {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .hero-name {
      display: none;
    }

    .hero-grid {
      display: block;
    }

    .hero-copy {
      padding-left: 0;
    }

    .detail-panel {
      display: none;
    }
  }
</style>
