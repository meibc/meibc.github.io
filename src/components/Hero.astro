---
import profile from '../data/profile.json';

const emphasizeBio = (text: string) =>
  text
    .replace('quantitative and systems-based approaches', '<strong>quantitative and systems-based approaches</strong>')
    .replace('simulation modeling', '<span class="hover-term" tabindex="0"><strong>simulation modeling</strong></span>')
    .replace('decision-relevant tools', '<strong>decision-relevant tools</strong>');

const bioParagraphs = Array.isArray(profile.bio)
  ? profile.bio
  : String(profile.bio)
      .split(/\n+/)
      .map((p) => p.trim())
      .filter(Boolean);

const linkByPlatform = Object.fromEntries(
  (profile.socialLinks ?? []).map((link) => [link.platform, link.url])
);

const quickLinks = [
  { label: 'GitHub', href: linkByPlatform.github || 'https://github.com/meibc', external: true },
  { label: 'LinkedIn', href: linkByPlatform.linkedin || 'https://linkedin.com/in/', external: true },
  { label: 'Google Scholar', href: linkByPlatform.googleScholar || '#', external: true },
  { label: 'Publications', href: '#publications', external: false },
  { label: 'Research', href: '#research', external: false },
];
---

<section id="about" class="section hero">
  <div class="container hero-grid hero-copy">
    <div class="hero-content">
      {bioParagraphs.map((paragraph) => (
        <p class="hero-bio" set:html={emphasizeBio(paragraph)}></p>
      ))}
      <nav class="hero-links" aria-label="Quick links">
        {quickLinks.map((link) => (
          <a
            href={link.href}
            class="hero-link"
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <aside class="detail-panel" aria-live="polite">
      <h3>Simulation Modeling</h3>
      <p>I use simulation models to represent feedback loops, delays, adaptation, and behavior over time in complex health and social systems.</p>
      <p>This enables in-silico policy testing before implementation, including intervention timing, scale, and interaction effects under real-world constraints.</p>
      <p>Typical outputs include scenario comparisons, tipping-point sensitivity, and uncertainty-aware projections that support practical decision-making.</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: 84px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 500px) minmax(420px, 1fr);
    gap: 38px;
    align-items: start;
  }

  .hero-bio {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    line-height: 1.68;
    max-width: 100%;
    margin: 0;
  }

  .hero-content {
    display: grid;
    gap: 0.9rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-top: 0.2rem;
  }

  .hero-link {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5f5a52;
    border-bottom: 1px solid rgba(95, 90, 82, 0.28);
    padding-bottom: 0.08rem;
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .hero-link:hover {
    color: #3d3934;
    border-bottom-color: rgba(61, 57, 52, 0.52);
  }

  .hero-bio :global(strong) {
    color: #4d4a46;
    font-weight: 700;
  }

  .hero-bio :global(.hover-term) {
    position: relative;
    display: inline;
    cursor: help;
    border-bottom: 1px solid rgba(63, 59, 54, 0.45);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .hero-bio :global(.hover-term:hover),
  .hero-bio :global(.hover-term:focus),
  .hero-bio :global(.hover-term:focus-within) {
    color: #3f3b36;
    border-bottom-color: rgba(63, 59, 54, 0.78);
  }

  .detail-panel {
    min-height: clamp(460px, 68vh, 720px);
    max-height: 78vh;
    overflow-y: auto;
    padding: 24px 26px;
    border-radius: 6px;
    border: 1px solid rgba(67, 64, 60, 0.08);
    background: #d4d4d6;
    color: #4c4844;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    font-size: 0.98rem;
    line-height: 1.58;
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .detail-panel h3 {
    font-size: clamp(2.05rem, 3vw, 2.55rem);
    line-height: 1.08;
    font-weight: 700;
    color: #5a5653;
    margin-bottom: 14px;
    text-transform: lowercase;
  }

  .detail-panel p:first-of-type {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 12px;
  }

  .detail-panel p + p {
    margin-top: 11px;
  }

  .detail-panel::-webkit-scrollbar {
    width: 8px;
  }

  .detail-panel::-webkit-scrollbar-thumb {
    background: rgba(84, 80, 75, 0.28);
    border-radius: 999px;
  }

  .hero-copy:has(.hover-term:hover) .detail-panel,
  .hero-copy:has(.hover-term:focus) .detail-panel,
  .hero-copy:has(.hover-term:focus-within) .detail-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-md);
    }

    .hero-bio {
      font-size: 1.02rem;
      line-height: 1.6;
    }

    .hero-links {
      gap: 0.4rem 0.7rem;
    }

    .hero-link {
      font-size: 0.78rem;
    }

    .hero-grid {
      display: block;
    }

    .detail-panel {
      margin-top: 14px;
      min-height: 0;
      max-height: 300px;
      padding: 16px 16px;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .detail-panel h3 {
      font-size: 1.6rem;
      margin-bottom: 10px;
    }

    .detail-panel p:first-of-type {
      font-size: 1rem;
    }
  }
</style>
