---
import profile from '../data/profile.json';

const highlightedBio = profile.bio
  .replace('quantitative and systems-based approaches', '<strong>quantitative and systems-based approaches</strong>')
  .replace('simulation modeling', '<strong>simulation modeling</strong>')
  .replace('decision-relevant tools', '<strong>decision-relevant tools</strong>');
---

<section id="about" class="section hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="hero-bio" set:html={highlightedBio}></p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 84px;
  }

  .hero-grid {
    display: block;
  }

  .hero-bio {
    color: var(--color-text-secondary);
    font-size: 1.28rem;
    line-height: 1.45;
    max-width: 760px;
    margin: 0;
  }

  .hero-bio :global(strong) {
    color: #4d4a46;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-md);
    }

    .hero-bio {
      font-size: 1.02rem;
      line-height: 1.6;
    }
  }
</style>
