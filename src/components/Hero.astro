---
import profile from '../data/profile.json';

const highlightedBio = profile.bio
  .replace('quantitative and systems-based approaches', '<strong>quantitative and systems-based approaches</strong>')
  .replace('simulation modeling', '<span class="hover-term" tabindex="0"><strong>simulation modeling</strong></span>')
  .replace('decision-relevant tools', '<strong>decision-relevant tools</strong>');
---

<section id="about" class="section hero">
  <div class="container hero-grid hero-copy">
    <div class="hero-content">
      <p class="hero-bio" set:html={highlightedBio}></p>
    </div>
    <aside class="detail-panel" aria-live="polite">
      <h3>Simulation Modeling</h3>
      <p>I use simulation models to represent feedback loops, delays, adaptation, and behavior over time in complex health and social systems.</p>
      <p>This enables in-silico policy testing before implementation, including intervention timing, scale, and interaction effects under real-world constraints.</p>
      <p>Typical outputs include scenario comparisons, tipping-point sensitivity, and uncertainty-aware projections that support practical decision-making.</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: 84px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 520px) minmax(290px, 380px);
    gap: 34px;
    align-items: start;
  }

  .hero-bio {
    color: var(--color-text-secondary);
    font-size: 1.16rem;
    line-height: 1.72;
    max-width: 100%;
    margin: 0;
  }

  .hero-bio :global(strong) {
    color: #4d4a46;
    font-weight: 700;
  }

  .hero-bio :global(.hover-term) {
    position: relative;
    display: inline;
    cursor: help;
    border-bottom: 1px dotted rgba(28, 38, 65, 0.45);
  }

  .detail-panel {
    max-height: 390px;
    overflow-y: auto;
    padding: 16px 18px;
    border-radius: 10px;
    border: 1px solid rgba(28, 38, 65, 0.18);
    background: #f4f1ea;
    color: #433e36;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
    font-size: 0.94rem;
    line-height: 1.56;
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .detail-panel h3 {
    font-size: 0.86rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2f3d63;
    margin-bottom: 10px;
  }

  .detail-panel p + p {
    margin-top: 10px;
  }

  .hero-copy:has(.hover-term:hover) .detail-panel,
  .hero-copy:has(.hover-term:focus) .detail-panel,
  .hero-copy:has(.hover-term:focus-within) .detail-panel {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-md);
    }

    .hero-bio {
      font-size: 1.02rem;
      line-height: 1.6;
    }

    .hero-grid {
      display: block;
    }

    .detail-panel {
      margin-top: 14px;
      max-height: 260px;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>
