---
import profile from '../data/profile.json';

const highlightedBio = profile.bio
  .replace('quantitative and systems-based approaches', '<strong>quantitative and systems-based approaches</strong>')
  .replace(
    'simulation modeling',
    '<span class="hover-term" tabindex="0"><strong>simulation modeling</strong><span class="hover-card"><strong>Simulation Modeling</strong><br/>I use simulation models to represent feedback loops, delays, and behavior over time. This supports policy experiments in silico before real-world implementation.<br/><br/>Typical outputs include scenario comparisons, tipping-point sensitivity, and uncertainty-aware projections.</span></span>'
  )
  .replace('decision-relevant tools', '<strong>decision-relevant tools</strong>');
---

<section id="about" class="section hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="hero-bio" set:html={highlightedBio}></p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 84px;
  }

  .hero-grid {
    display: block;
  }

  .hero-bio {
    color: var(--color-text-secondary);
    font-size: 1.16rem;
    line-height: 1.72;
    max-width: 520px;
    margin: 0;
  }

  .hero-bio :global(strong) {
    color: #4d4a46;
    font-weight: 700;
  }

  .hero-bio :global(.hover-term) {
    position: relative;
    display: inline;
    cursor: help;
  }

  .hero-bio :global(.hover-card) {
    position: absolute;
    left: 0;
    top: calc(100% + 10px);
    width: min(380px, 78vw);
    max-height: 230px;
    overflow-y: auto;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid rgba(28, 38, 65, 0.2);
    background: #f7f4ee;
    color: #3f3a34;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.14);
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s ease;
    z-index: 12;
  }

  .hero-bio :global(.hover-term:hover .hover-card),
  .hero-bio :global(.hover-term:focus .hover-card),
  .hero-bio :global(.hover-term:focus-within .hover-card) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-md);
    }

    .hero-bio {
      font-size: 1.02rem;
      line-height: 1.6;
      max-width: 100%;
    }

    .hero-bio :global(.hover-card) {
      width: min(340px, 86vw);
      max-height: 180px;
    }
  }
</style>
