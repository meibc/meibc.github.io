---
import profile from '../data/profile.json';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Research', href: '#research' },
  { label: 'Publications', href: '#publications' },
  { label: 'CV', href: '#cv' },
];
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <a href="#about" class="profile-block">
      {
        profile.photo ? (
          <img
            src={profile.photo}
            alt={`${profile.name} profile photo`}
            class="sidebar-photo"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="sidebar-photo-fallback">
            <span>{profile.name.split(' ').map(n => n[0]).join('')}</span>
          </div>
        )
      }
      <h1 class="site-name">{profile.name}</h1>
      <p class="site-title">{profile.title}</p>
      <p class="site-affiliation">{profile.affiliation}</p>
    </a>
    <nav>
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
    <div class="sidebar-social">
      <SocialLinks links={profile.socialLinks} />
    </div>
    <p class="sidebar-footer">&copy; {year} Meibin Chen. Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.</p>
  </div>
</aside>

<header class="mobile-header">
  <a href="#about" class="mobile-name">Meibin Chen</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />
  <label for="nav-toggle" class="nav-hamburger" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </label>
  <nav class="mobile-nav">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  /* ── Desktop sidebar ── */
  .sidebar {
    display: flex;
    height: 100vh;
    position: sticky;
    top: 0;
    background: var(--sidebar-bg);
  }

  .sidebar-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 84px 36px 28px;
    gap: 22px;
  }

  .profile-block {
    display: block;
    text-decoration: none;
  }

  .sidebar-photo,
  .sidebar-photo-fallback {
    width: 122px;
    height: 122px;
    border-radius: 999px;
    border: 1px solid rgba(219, 196, 136, 0.45);
    margin-bottom: 18px;
  }

  .sidebar-photo {
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .sidebar-photo-fallback {
    background: linear-gradient(135deg, #6a7a8a, #9aa8b8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f1f3f6;
    font-size: 2rem;
    font-weight: 700;
  }

  .site-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 2rem;
    color: #dbc488;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .site-title,
  .site-affiliation {
    color: rgba(219, 196, 136, 0.9);
    font-size: 0.98rem;
    line-height: 1.45;
    margin: 0;
  }

  .site-affiliation {
    margin-top: 4px;
    max-width: 220px;
  }

  nav {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: rgba(219, 196, 136, 0.78);
    text-decoration: none;
    padding: 9px 0;
    border-bottom: 1px solid rgba(219, 196, 136, 0.16);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 0.2s ease;
  }

  .nav-link::before {
    content: '';
    display: block;
    width: 0;
    height: 1px;
    background: rgba(219, 196, 136, 0.9);
    transition: width 0.2s ease;
    flex-shrink: 0;
  }

  .nav-link:hover { color: rgba(238, 221, 169, 0.96); }
  .nav-link:hover::before { width: 8px; }
  .nav-link.active { color: #f1dfb0; }
  .nav-link.active::before { width: 14px; }

  .sidebar-social {
    margin-top: 2px;
  }

  .sidebar-social :global(.social-links) {
    margin-top: 0;
    gap: 14px;
  }

  .sidebar-social :global(.social-links a) {
    color: rgba(219, 196, 136, 0.72);
  }

  .sidebar-social :global(.social-links a:hover) {
    color: #f1dfb0;
    transform: translateY(-1px);
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(219, 196, 136, 0.72);
    border-top: 1px solid rgba(219, 196, 136, 0.18);
  }

  .sidebar-footer a {
    color: rgba(236, 218, 164, 0.9);
  }

  .sidebar-footer a:hover {
    color: #f6e6be;
  }

  /* ── Mobile ── */
  .nav-toggle { display: none; }
  .mobile-header { display: none; }

  @media (max-width: 768px) {
    .sidebar { display: none; }

    .mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      padding: 0.875rem 1.25rem;
      position: fixed;
      top: 0; left: 0; right: 0;
      background: var(--sidebar-bg);
      z-index: 100;
      border-bottom: 1px solid rgba(219, 196, 136, 0.16);
    }

    .mobile-name {
      font-family: var(--font-sans);
      font-weight: 700;
      color: #dbc488;
      font-size: 1rem;
      text-decoration: none;
    }

    .nav-hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.25rem;
    }

    .nav-hamburger span {
      width: 22px;
      height: 1px;
      background: rgba(219, 196, 136, 0.72);
      transition: transform 0.2s, opacity 0.2s;
      display: block;
    }

    .mobile-nav {
      width: 100%;
      display: flex;
      flex-direction: column;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  padding 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0;
    }

    .nav-toggle:checked ~ .mobile-nav {
      padding-top: 0.75rem;
    }

    .mobile-nav a {
      font-family: var(--font-sans);
      font-weight: 400;
      color: rgba(219, 196, 136, 0.9);
      text-decoration: none;
      padding: 0.5rem 0;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(219, 196, 136, 0.16);
    }

    .nav-toggle:checked ~ .nav-hamburger span:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }
    .nav-toggle:checked ~ .mobile-nav { max-height: 300px; }
  }
</style>
