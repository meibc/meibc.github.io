---
const navLinks = [
  { label: 'About', href: '#about' },
  { label: 'Research', href: '#research' },
  { label: 'Publications', href: '#publications' },
  { label: 'CV', href: '#cv' },
];
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <a href="#about" class="site-name">meibin chen</a>
    <nav>
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
  </div>
  <div class="sidebar-divider" aria-hidden="true"></div>
</aside>

<header class="mobile-header">
  <a href="#about" class="mobile-name">Meibin Chen</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />
  <label for="nav-toggle" class="nav-hamburger" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </label>
  <nav class="mobile-nav">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  /* ── Desktop sidebar ── */
  .sidebar {
    display: flex;
    height: 100vh;
    position: sticky;
    top: 0;
  }

  .sidebar-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 32px;
    gap: 52px;
  }

  .sidebar-divider {
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(255,255,255,0.07) 20%,
      rgba(255,255,255,0.07) 80%,
      transparent 100%
    );
  }

  .site-name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.05rem;
    color: #c8c4bc;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-decoration: none;
  }

  .site-name:hover {
    color: #e0dcd4;
  }

  nav {
    display: flex;
    flex-direction: column;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: #6a7a8a;
    text-decoration: none;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    display: flex;
    align-items: center;
    gap: 10px;
    transition: color 0.22s;
  }

  .nav-link::before {
    content: '';
    display: block;
    width: 0;
    height: 1px;
    background: #d4b896;
    transition: width 0.25s ease;
    flex-shrink: 0;
  }

  .nav-link:hover { color: #9aa8b8; }
  .nav-link:hover::before { width: 10px; }
  .nav-link.active { color: #c8c4bc; }
  .nav-link.active::before { width: 18px; }

  /* ── Mobile ── */
  .nav-toggle { display: none; }
  .mobile-header { display: none; }

  @media (max-width: 768px) {
    .sidebar { display: none; }

    .mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      padding: 0.875rem 1.25rem;
      position: fixed;
      top: 0; left: 0; right: 0;
      background: #1e2535;
      z-index: 100;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .mobile-name {
      font-family: var(--font-sans);
      font-weight: 300;
      color: #c8c4bc;
      font-size: 1rem;
      text-decoration: none;
    }

    .nav-hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.25rem;
    }

    .nav-hamburger span {
      width: 22px;
      height: 1px;
      background: #6a7a8a;
      transition: transform 0.2s, opacity 0.2s;
      display: block;
    }

    .mobile-nav {
      width: 100%;
      display: none;
      flex-direction: column;
      padding: 0.75rem 0 0.25rem;
    }

    .mobile-nav a {
      font-family: var(--font-sans);
      font-weight: 300;
      color: #6a7a8a;
      text-decoration: none;
      padding: 0.5rem 0;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .nav-toggle:checked ~ .nav-hamburger span:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }
    .nav-toggle:checked ~ .mobile-nav { display: flex; }
  }
</style>
