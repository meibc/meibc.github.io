---
import profile from '../data/profile.json';
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();

const navLinks = [
  { label: 'Research', href: '#research' },
  { label: 'Publications', href: '#publications' },
  { label: 'CV', href: '#cv' },
];
---

<aside class="sidebar">
  <div class="sidebar-inner">
    <div class="sidebar-shell">
      <a href="#about" class="profile-block">
        {
          profile.photo ? (
            <img
              src={profile.photo}
              alt={`${profile.name} profile photo`}
              class="sidebar-photo"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="sidebar-photo-fallback">
              <span>{profile.name.split(' ').map(n => n[0]).join('')}</span>
            </div>
          )
        }
        <p class="site-title"><strong>PhD Candidate</strong></p>
        <p class="site-affiliation">Department of Systems Engineering,<br />Johns Hopkins University</p>
      </a>
      <div class="sidebar-social">
        <SocialLinks links={profile.socialLinks} />
      </div>
      <nav>
        {navLinks.map(link => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </nav>
    </div>
    <p class="sidebar-footer">&copy; {year} Meibin Chen. Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.</p>
  </div>
</aside>

<header class="mobile-header">
  <a href="#about" class="mobile-name">Meibin Chen</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />
  <label for="nav-toggle" class="nav-hamburger" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </label>
  <nav class="mobile-nav">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  /* ── Desktop sidebar ── */
  .sidebar {
    display: flex;
    height: 100vh;
    position: sticky;
    top: 0;
    background: var(--sidebar-bg);
  }

  .sidebar-inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 70px 28px 24px;
    gap: 16px;
  }

  .sidebar-shell {
    width: min(210px, 100%);
    margin: 0 auto;
  }

  .profile-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
  }

  .sidebar-photo,
  .sidebar-photo-fallback {
    width: 126px;
    height: 126px;
    border-radius: 999px;
    border: 1px solid rgba(61, 61, 61, 0.22);
    margin-top: 8px;
    margin-bottom: 18px;
    margin-left: auto;
    margin-right: auto;
    align-self: center;
  }

  .sidebar-photo {
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .sidebar-photo-fallback {
    background: linear-gradient(135deg, #6a7a8a, #9aa8b8);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f1f3f6;
    font-size: 2rem;
    font-weight: 700;
  }

  .site-title,
  .site-affiliation {
    color: rgba(61, 61, 61, 0.9);
    font-size: 0.94rem;
    line-height: 1.55;
    margin: 0;
  }

  .site-affiliation {
    margin-top: 4px;
    max-width: 220px;
  }

  .sidebar-social {
    margin-top: 20px;
    margin-bottom: 8px;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .sidebar-social :global(.social-links) {
    margin-top: 0;
    gap: 10px;
    justify-content: center;
  }

  .sidebar-social :global(.social-links a) {
    color: rgba(61, 61, 61, 0.78);
  }

  .sidebar-social :global(.social-links a:hover) {
    color: #5F7FA1;
    transform: translateY(-1px);
  }

  nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 24px;
    margin-left: 8px;
    gap: 10px;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(61, 61, 61, 0.92);
    text-decoration: none;
    padding: 10px 0;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
    text-align: left;
    transition: color 0.2s ease;
  }

  .nav-link::before {
    content: '';
    width: 0;
    height: 1px;
    background: rgba(95, 127, 161, 0.9);
    transition: width 0.2s ease;
  }

  .nav-link:hover {
    color: #47698C;
  }

  .nav-link:hover::before {
    width: 10px;
  }

  .nav-link.active {
    color: #47698C;
  }

  .nav-link.active::before {
    width: 16px;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 14px;
    font-size: 0.74rem;
    line-height: 1.5;
    text-align: center;
    color: rgba(61, 61, 61, 0.72);
    border-top: 1px solid rgba(61, 61, 61, 0.18);
  }

  .sidebar-footer a {
    color: #5F7FA1;
  }

  .sidebar-footer a:hover {
    color: #47698C;
  }

  /* ── Mobile ── */
  .nav-toggle { display: none; }
  .mobile-header { display: none; }

  @media (max-width: 768px) {
    .sidebar { display: none; }

    .mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      padding: 0.875rem 1.25rem;
      position: fixed;
      top: 0; left: 0; right: 0;
      background: var(--sidebar-bg);
      z-index: 100;
      border-bottom: 1px solid rgba(61, 61, 61, 0.16);
    }

    .mobile-name {
      font-family: var(--font-sans);
      font-weight: 700;
      color: #3D3D3D;
      font-size: 1rem;
      text-decoration: none;
    }

    .nav-hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.25rem;
    }

    .nav-hamburger span {
      width: 22px;
      height: 1px;
      background: rgba(61, 61, 61, 0.72);
      transition: transform 0.2s, opacity 0.2s;
      display: block;
    }

    .mobile-nav {
      width: 100%;
      display: flex;
      flex-direction: column;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  padding 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0;
    }

    .nav-toggle:checked ~ .mobile-nav {
      padding-top: 0.75rem;
    }

    .mobile-nav a {
      font-family: var(--font-sans);
      font-weight: 400;
      color: rgba(61, 61, 61, 0.92);
      text-decoration: none;
      padding: 0.5rem 0;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(61, 61, 61, 0.16);
    }

    .nav-toggle:checked ~ .nav-hamburger span:nth-child(1) { transform: rotate(45deg) translate(4px, 4px); }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-hamburger span:nth-child(3) { transform: rotate(-45deg) translate(4px, -4px); }
    .nav-toggle:checked ~ .mobile-nav { max-height: 300px; }
  }
</style>
