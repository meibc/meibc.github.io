---
import Tag from './Tag.astro';

interface Props {
  title: string;
  authors: string[];
  venue: string;
  year: number;
  links?: {
    pdf?: string;
    doi?: string;
    arxiv?: string;
    code?: string;
  };
}

const { title, authors, venue, year, links } = Astro.props;
const ownerName = 'Meibin Chen';
---

<div class="pub-entry">
  <p class="pub-authors">
    {authors.map((author, i) => (
      <>
        <span class:list={{ owner: author === ownerName, other: author !== ownerName }}>
          {author}
        </span>
        {i < authors.length - 1 && <span class="sep">, </span>}
      </>
    ))}
  </p>
  <h3 class="pub-title">{title}</h3>
  <p class="pub-venue">{venue}, {year}</p>
  {links && (
    <div class="pub-links">
      {links.pdf && <Tag label="PDF" />}
      {links.doi && <Tag label="DOI" />}
      {links.arxiv && <Tag label="arXiv" />}
      {links.code && <Tag label="Code" />}
    </div>
  )}
</div>

<style>
  .pub-entry {
    padding: 20px 0;
    border-bottom: 1px solid var(--rule);
  }

  .pub-entry:last-child {
    border-bottom: none;
  }

  .pub-authors {
    font-size: 0.9rem;
    margin-bottom: 4px;
    line-height: 1.5;
  }

  .pub-authors .owner {
    font-weight: 400;
    color: var(--text);
  }

  .pub-authors .other {
    font-weight: 300;
    color: var(--text-mid);
  }

  .pub-authors .sep {
    color: var(--text-mid);
    font-weight: 300;
  }

  .pub-title {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 400;
    color: var(--slate);
    line-height: 1.5;
    margin-bottom: 4px;
  }

  .pub-venue {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .pub-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
</style>
