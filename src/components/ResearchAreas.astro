---
import PageTitle from './PageTitle.astro';
import research from '../data/research.json';

type ResearchItem = {
  title: string;
  preview: string;
  image: string;
  imageAlt: string;
  viewMore: string;
};

const items = research as ResearchItem[];
---

<section id="research" class="section">
  <div class="container">
    <PageTitle title="Research" />

    <div class="research-grid">
      {items.map((item, idx) => (
        <article class={`research-row ${idx % 2 ? 'reverse' : ''}`}>
          <a class="research-image-wrap" href={item.viewMore} aria-label={`Read more about ${item.title}`}>
            <img src={item.image} alt={item.imageAlt} class="research-image" loading="lazy" />
          </a>

          <div class="research-copy">
            <h3>{item.title}</h3>
            <p>{item.preview}</p>
            <a href={item.viewMore} class="read-more">Read more →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .research-grid {
    display: grid;
    gap: 2rem;
  }

  .research-row {
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    gap: 1.4rem;
    align-items: center;
    padding: 0.9rem 0;
  }

  .research-row.reverse {
    grid-template-columns: 1fr minmax(240px, 320px);
  }

  .research-row.reverse .research-image-wrap {
    order: 2;
  }

  .research-row.reverse .research-copy {
    order: 1;
  }

  .research-image-wrap {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .research-image {
    width: 100%;
    height: 100%;
    min-height: 180px;
    max-height: 220px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .research-copy h3 {
    font-size: 1.16rem;
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .research-copy p {
    font-size: 0.98rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.52rem;
    max-width: 64ch;
  }

  .read-more {
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .read-more:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 768px) {
    .research-grid {
      gap: 1.4rem;
    }

    .research-row,
    .research-row.reverse {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 0.4rem 0 0.75rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .research-row:last-child {
      border-bottom: none;
    }

    .research-row.reverse .research-image-wrap,
    .research-row.reverse .research-copy {
      order: initial;
    }

    .research-image {
      min-height: 165px;
      max-height: 210px;
    }

    .research-copy h3 {
      font-size: 1.03rem;
    }

    .research-copy p {
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 100%;
    }
  }
</style>
