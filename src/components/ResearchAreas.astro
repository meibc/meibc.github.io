---
import PageTitle from './PageTitle.astro';
import Tag from './Tag.astro';
import research from '../data/research.json';

const getFeaturedWork = (item) => item.featuredWork ?? item.featuredPapers ?? [];
---

<section id="research" class="section">
  <div class="container">
    <PageTitle title="Research" />
    <div class="research-list">
      {research.map(area => (
        <div class="research-area">
          <div class="area-main">
            <h3 class="area-title">{area.title}</h3>
            <p class="area-desc">{area.description}</p>
          </div>

          {area.subareas?.length ? (
            <div class="subareas">
              {area.subareas.map(subarea => (
                <div class="subarea">
                  <h4 class="subarea-title">{subarea.title}</h4>
                  {subarea.description && <p class="subarea-desc">{subarea.description}</p>}

                  {getFeaturedWork(subarea).length > 0 && (
                    <div class="featured-papers">
                      <p class="paper-label">
                        Featured Work{getFeaturedWork(subarea).length > 1 ? 's' : ''}
                      </p>
                      {getFeaturedWork(subarea).map(work => (
                        <div class="featured-paper">
                          <p class="paper-title">{work.title}</p>
                          <p class="paper-venue">{work.venue}</p>
                          <div class="paper-links">
                            {work.links.viewMore && (
                              <a href={work.links.viewMore}><Tag label="View More" /></a>
                            )}
                            {work.links.paper && (
                              <a href={work.links.paper} target="_blank" rel="noopener"><Tag label="Paper" /></a>
                            )}
                            {work.links.code && (
                              <a href={work.links.code} target="_blank" rel="noopener"><Tag label="Code" /></a>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <div class="featured-papers">
              <p class="paper-label">Featured Work{getFeaturedWork(area).length > 1 ? 's' : ''}</p>
              {getFeaturedWork(area).map(work => (
                <div class="featured-paper">
                  <p class="paper-title">{work.title}</p>
                  <p class="paper-venue">{work.venue}</p>
                  <div class="paper-links">
                    {work.links.viewMore && (
                      <a href={work.links.viewMore}><Tag label="View More" /></a>
                    )}
                    {work.links.paper && (
                      <a href={work.links.paper} target="_blank" rel="noopener"><Tag label="Paper" /></a>
                    )}
                    {work.links.code && (
                      <a href={work.links.code} target="_blank" rel="noopener"><Tag label="Code" /></a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .research-list {
    display: flex;
    flex-direction: column;
  }

  .research-area {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding: 20px 0 20px 16px;
    border-bottom: 1px solid var(--rule);
    border-left: 2px solid transparent;
    transition: border-left-color 0.2s ease;
    align-items: start;
  }

  .research-area:last-child {
    border-bottom: none;
  }

  .research-area:hover {
    border-left-color: var(--gold);
  }

  .area-title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .area-desc {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.7;
  }

  .subareas {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .subarea {
    padding: 14px 16px;
    border: 1px solid var(--rule);
    background: rgba(201, 169, 97, 0.03);
  }

  .subarea-title {
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--slate);
    margin-bottom: 6px;
  }

  .subarea-desc {
    font-size: 0.9rem;
    color: var(--text-mid);
    line-height: 1.6;
    margin-bottom: 10px;
  }

  .featured-papers {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .featured-paper {
    padding: 14px 16px;
    border: 1px solid var(--rule);
    border-left: 2px solid var(--gold);
    background: rgba(201, 169, 97, 0.04);
  }

  .paper-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 6px;
  }

  .paper-title {
    font-size: 1rem;
    font-weight: 400;
    color: var(--slate);
    line-height: 1.5;
    margin-bottom: 4px;
  }

  .paper-venue {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .paper-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .paper-links a {
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .research-area {
      grid-template-columns: 1fr;
    }
  }
</style>
