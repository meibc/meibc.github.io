---
import PageTitle from './PageTitle.astro';
import research from '../data/research.json';

type ResearchItem = {
  title: string;
  preview: string;
  viewMore: string;
  paper?: string;
  code?: string;
  abstract?: string;
};

const items = research as ResearchItem[];
---

<section id="research" class="section">
  <div class="container research-shell">
    <PageTitle title="Research" />

    <div class="research-grid">
      {items.map((item) => (
        <article class="research-row">
          <div class="research-copy">
            <h3>{item.title}</h3>
            <p>{item.preview}</p>
            <div class="research-links">
              {item.paper && (
                <a href={item.paper} class="aux-link" target="_blank" rel="noopener noreferrer">Paper</a>
              )}
              {item.abstract && (
                <a href={item.abstract} class="aux-link" target="_blank" rel="noopener noreferrer">Abstract</a>
              )}
              {item.code && (
                <a href={item.code} class="aux-link" target="_blank" rel="noopener noreferrer">Code</a>
              )}
              <a href={item.viewMore} class="read-more">Read more →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .research-shell {
    padding-left: 50px;
  }

  #research {
    padding-top: 78px;
  }

  .research-grid {
    display: grid;
    gap: 2rem;
  }

  .research-row {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .research-copy h3 {
    font-size: 1.16rem;
    line-height: 1.25;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .research-copy p {
    font-size: 0.98rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.52rem;
    max-width: 64ch;
  }

  .read-more {
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .research-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
  }

  .aux-link {
    font-size: 0.84rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(95, 127, 161, 0.42);
  }

  .aux-link:hover {
    color: var(--color-accent-light);
    text-decoration-color: rgba(71, 105, 140, 0.62);
  }

  .read-more:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 768px) {
    .research-shell {
      padding-left: 0;
    }

    #research {
      padding-top: 1rem;
    }

    .research-grid {
      gap: 1.4rem;
    }

    .research-row {
      padding: 0.4rem 0 0.75rem;
    }

    .research-row:last-child {
      border-bottom: none;
    }

    .research-copy h3 {
      font-size: 1.03rem;
    }

    .research-copy p {
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 100%;
    }
  }
</style>
