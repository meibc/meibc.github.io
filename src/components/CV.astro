---
import PageTitle from './PageTitle.astro';
import SectionHeader from './SectionHeader.astro';
import ContentRow from './ContentRow.astro';
import cv from '../data/cv-entries.json';
---

<section id="cv" class="section">
  <div class="container">
    <PageTitle title="CV" />

    <a href="/cv.pdf" target="_blank" rel="noopener" class="download-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
      Download CV
    </a>

    <div class="cv-sections">
      <div class="cv-group">
        <SectionHeader label="Education" />
        {cv.education.map(item => (
          <ContentRow
            title={item.degree}
            date={item.years}
            subtitle={item.institution}
            body={item.description}
          />
        ))}
      </div>

      <div class="cv-group">
        <SectionHeader label="Experience" />
        {cv.experience.map(item => (
          <ContentRow
            title={item.role}
            date={item.years}
            subtitle={item.organization}
            body={item.description}
          />
        ))}
      </div>

      <div class="cv-group">
        <SectionHeader label="Awards" />
        {cv.awards.map(item => (
          <ContentRow
            title={item.name}
            date={item.year}
            subtitle={item.venue}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(91, 124, 153, 0.4);
    color: var(--slate);
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.9rem;
    padding: 9px 16px;
    border-radius: 2px;
    margin-bottom: var(--space-lg);
    transition: border-color 0.2s, color 0.2s;
  }

  .download-btn:hover {
    border-color: var(--slate);
    color: var(--slate-dim);
  }

  .cv-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>
